@article{musker_universal_1980,
	title = {Universal {Roughness} {Functions} for {Naturally}-{Occurring} {Surfaces}},
	volume = {6},
	copyright = {http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining},
	issn = {0315-8977, 2816-5691},
	url = {https://cdnsciencepub.com/doi/10.1139/tcsme-1980-0001},
	doi = {10.1139/tcsme-1980-0001},
	abstract = {The possibility that simple correlations might exist between certain geometrical parameters describing naturally-occurring surfaces and the corresponding roughness functions is explored. The importance of describing the surface geometry in terms of parameters which have some relevance to the mechanics in the immediate vicinity of the surface excrescences is emphasised. A crude model is proposed which leads to the concept of an ‘effective roughness height’ the purpose of which is to collapse the roughness functions, corresponding to a particular class of surfaces, onto a universal curve. Since the surface description is a function of the bandwidth of wavelengths used in the analysis, it is necessary for this purpose to consider which wavelengths relating to a typical surface profile are responsible for localised eddy-shedding. The above points are discussed and an experiment is described in which some of the ideas are applied to a set of irregularly-rough surfaces corresponding to seven different ship-hull replicas. Although the results are somewhat tentative it is the author’s’ opinion that more research along the lines outlined in this paper may enable the roughness function corresponding to a naturally-occurring surface to be predicted with reasonable accuracy on the basis of a knowledge of the surface geometry.},
	language = {en},
	number = {1},
	urldate = {2026-06-10},
	journal = {Transactions of the Canadian Society for Mechanical Engineering},
	author = {Musker, A.J.},
	month = mar,
	year = {1980},
	pages = {1--6},
	file = {PDF:/home/jonas/Zotero/storage/67LAFS6G/Musker - 1980 - Universal Roughness Functions for Naturally-Occurring Surfaces.pdf:application/pdf},
}

@article{napoli_effect_2008,
	title = {The effect of the slope of irregularly distributed roughness elements on turbulent wall-bounded flows},
	volume = {613},
	copyright = {https://www.cambridge.org/core/terms},
	issn = {0022-1120, 1469-7645},
	url = {https://www.cambridge.org/core/product/identifier/S0022112008003571/type/journal_article},
	doi = {10.1017/S0022112008003571},
	abstract = {Wall roughness produces a downward shift of the mean streamwise velocity profile in the log region, known as the
              roughness function
              . The dependence of the roughness function on the height and arrangement of roughness elements has been confirmed in several studies where regular rough walls were analysed; less attention has been paid to non-regular rough walls. Here, a numerical analysis of turbulent flows over irregularly shaped rough walls is performed, clearly identifying the importance of a parameter, called the
              effective slope
              (
              ES
              ) of the wall corrugations, in characterizing the geometry of non-smooth irregular walls. The effective slope proves to be one of the fundamental geometric parameters for scaling the roughness function. Specifically, for a moderate range of roughness heights, both in the transitionally and in the fully rough regime,
              ES
              appears to scale the roughness function for a wide range of irregular rough geometric configurations. The effective slope determines the relative importance of friction drag and pressure drag. For
              ES
              {\textasciitilde} 0.15 we find that the friction contribution to the total wall stress is nearly in balance with the pressure-drag contribution. This value separates the region where the roughness function Δ
              U
              +
              =
              f
              (
              ES
              ) is linear from that where a smooth nonlinear behaviour is observed. In the cases investigated, value
              ES
              {\textasciitilde} 0.15 also separates the transitionally rough regime from the fully rough regime.},
	language = {en},
	urldate = {2026-06-10},
	journal = {Journal of Fluid Mechanics},
	author = {Napoli, E. and Armenio, V. and De Marchis, M.},
	month = oct,
	year = {2008},
	pages = {385--394},
	file = {PDF:/home/jonas/Zotero/storage/IPRP8G3G/Napoli et al. - 2008 - The effect of the slope of irregularly distributed roughness elements on turbulent wall-bounded flow.pdf:application/pdf},
}

@article{schultz_rough-wall_2007,
	title = {The rough-wall turbulent boundary layer from the hydraulically smooth to the fully rough regime},
	volume = {580},
	copyright = {https://www.cambridge.org/core/terms},
	issn = {0022-1120, 1469-7645},
	url = {https://www.cambridge.org/core/product/identifier/S0022112007005502/type/journal_article},
	doi = {10.1017/S0022112007005502},
	abstract = {Turbulence measurements for rough-wall boundary layers are presented and compared to those for a smooth wall. The rough-wall experiments were made on a three-dimensional rough surface geometrically similar to the honed pipe roughness used by Shockling, Allen \& Smits (
              J. Fluid Mech.
              vol. 564, 2006, p. 267). The present work covers a wide Reynolds-number range (
              Re
              θ
              = 2180–27 100), spanning the hydraulically smooth to the fully rough flow regimes for a single surface, while maintaining a roughness height that is a small fraction of the boundary-layer thickness. In this investigation, the root-mean-square roughness height was at least three orders of magnitude smaller than the boundary-layer thickness, and the Kármán number (δ
              +
              ), typifying the ratio of the largest to the smallest turbulent scales in the flow, was as high as 10100. The mean velocity profiles for the rough and smooth walls show remarkable similarity in the outer layer using velocity-defect scaling. The Reynolds stresses and higher-order turbulence statistics also show excellent agreement in the outer layer. The results lend strong support to the concept of outer layer similarity for rough walls in which there is a large separation between the roughness length scale and the largest turbulence scales in the flow.},
	language = {en},
	urldate = {2026-06-11},
	journal = {Journal of Fluid Mechanics},
	author = {Schultz, M. P. and Flack, K. A.},
	month = jun,
	year = {2007},
	pages = {381--405},
	file = {PDF:/home/jonas/Zotero/storage/QKBN43AC/Schultz and Flack - 2007 - The rough-wall turbulent boundary layer from the hydraulically smooth to the fully rough regime.pdf:application/pdf},
}

@article{flack_review_2010,
	title = {Review of {Hydraulic} {Roughness} {Scales} in the {Fully} {Rough} {Regime}},
	volume = {132},
	issn = {0098-2202, 1528-901X},
	url = {https://asmedigitalcollection.asme.org/fluidsengineering/article/doi/10.1115/1.4001492/459713/Review-of-Hydraulic-Roughness-Scales-in-the-Fully},
	doi = {10.1115/1.4001492},
	abstract = {A review of predictive methods used to determine the frictional drag on a rough surface is presented. These methods utilize a wide range of roughness scales, including roughness height, pitch, density, and shape parameters. Most of these scales were developed for regular roughness, limiting their applicability to predict the drag for many engineering flows. A new correlation is proposed to estimate the frictional drag for a surface covered with three-dimensional, irregular roughness in the fully rough regime. The correlation relies solely on a measurement of the surface roughness profile and builds on previous work utilizing moments of the surface statistics. A relationship is given for the equivalent sandgrain roughness height as a function of the root-mean-square roughness height and the skewness of the roughness probability density function. Boundary layer similarity scaling then allows the overall frictional drag coefficient to be determined as a function of the ratio of the equivalent sandgrain roughness height to length of the surface.},
	language = {en},
	number = {4},
	urldate = {2026-06-12},
	journal = {Journal of Fluids Engineering},
	author = {Flack, Karen A. and Schultz, Michael P.},
	month = apr,
	year = {2010},
	pages = {041203},
	file = {Flack, Schultz - Hydraulic Roughness Scales, 2010:/home/jonas/Zotero/storage/PVEB5HZ6/Flack and Schultz - 2010 - Review of Hydraulic Roughness Scales in the Fully Rough Regime.pdf:application/pdf},
}

@article{flack_skin_2020,
	title = {Skin {Friction} {Measurements} of {Systematically}-{Varied} {Roughness}: {Probing} the {Role} of {Roughness} {Amplitude} and {Skewness}},
	volume = {104},
	issn = {1386-6184, 1573-1987},
	shorttitle = {Skin {Friction} {Measurements} of {Systematically}-{Varied} {Roughness}},
	url = {http://link.springer.com/10.1007/s10494-019-00077-1},
	doi = {10.1007/s10494-019-00077-1},
	abstract = {Skin-friction, roughness functions and predictive correlations are presented for random roughness that has a Gaussian power spectral density distribution of surface elevations. The root-mean-square (rms) roughness height and the skewness of the probability density function are parametrically varied to investigate the role of these parameters in generating the friction at the wall. Results are presented for all roughness regimes, from hydraulically-smooth to fully-rough. Negative skewness (pits) had a much smaller influence on drag than positive skewness (peaks). Predictive engineering correlations for the equivalent sandgrain roughness height indicate that the rms roughess height and skewness are important scaling parameters. However, the scaling does not appear to be universal as different correlations are needed for surface roughness with positive, negative and zero skewness. Most surfaces collapse to a single roughness function in the transitionally-rough regime similar to the one developed by Nikuradase (1933) for uniform sand-grain roughness. The exceptions are the wavy surface (low effective slope) and the surface with high positive skewness.},
	language = {en},
	number = {2-3},
	urldate = {2026-06-12},
	journal = {Flow, Turbulence and Combustion},
	author = {Flack, K. A. and Schultz, M. P. and Barros, J. M.},
	month = mar,
	year = {2020},
	pages = {317--329},
	file = {PDF:/home/jonas/Zotero/storage/WV2NMURI/Flack et al. - 2020 - Skin Friction Measurements of Systematically-Varied Roughness Probing the Role of Roughness Amplitu.pdf:application/pdf},
}
