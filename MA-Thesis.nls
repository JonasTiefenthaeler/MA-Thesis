
\begin{thenomenclature} 
\nomgroup{F}
  \item [{$g_i$}]\begingroup Gravitational acceleration\nomeqref {0.0}\nompageref{X}
  \item [{$\mu$}]\begingroup Dynamic viscosity of the fluid\nomeqref {0.0}\nompageref{X}
  \item [{$\nu$}]\begingroup Kinematic viscosity of the fluid\nomeqref {0.0}\nompageref{X}
  \item [{$\rho$}]\begingroup Density of the fluid\nomeqref {0.0}\nompageref{X}
\nomgroup{G}
  \item [{$L_r$}]\begingroup Domain extent in wall-normal direction\nomeqref {0.0}\nompageref{X}
  \item [{$L_\theta$}]\begingroup Domain extent in azimuthal direction\nomeqref {0.0}\nompageref{X}
  \item [{$L_z$}]\begingroup Domain extent in streamwise direction\nomeqref {0.0}\nompageref{X}
  \item [{$\mathbf{n}$}]\begingroup Wall-normal unit vector\nomeqref {0.0}\nompageref{X}
  \item [{$R$}]\begingroup Pipe radius\nomeqref {0.0}\nompageref{X}
  \item [{$r$}]\begingroup radial coordinate\nomeqref {0.0}\nompageref{X}
  \item [{$r_{crit}$}]\begingroup Critical radius below which mesh points remain unshifted\nomeqref {0.0}\nompageref{X}
  \item [{$r_{shift}$}]\begingroup Radially shifted position of a mesh point\nomeqref {0.0}\nompageref{X}
  \item [{$\mathbf{s}$}]\begingroup Unit vector in streamwise direction\nomeqref {0.0}\nompageref{X}
  \item [{$\mathbf{t}$}]\begingroup Wall-tangential unit vector\nomeqref {0.0}\nompageref{X}
  \item [{$x_i$}]\begingroup Cartesian coordinate direction\nomeqref {0.0}\nompageref{X}
  \item [{$y$}]\begingroup Wall-normal distance from the wall\nomeqref {0.0}\nompageref{X}
  \item [{$z$}]\begingroup Streamwise coordinate\nomeqref {0.0}\nompageref{X}
  \item [{$\theta$}]\begingroup Azimuthal coordinate\nomeqref {0.0}\nompageref{X}
\nomgroup{K}
  \item [{$A$}]\begingroup Log-law intercept constant\nomeqref {0.0}\nompageref{X}
  \item [{$B$}]\begingroup Downward shift of the log-law intercept due to roughness\nomeqref {0.0}\nompageref{X}
  \item [{$C_f$}]\begingroup Skin friction coefficient\nomeqref {0.0}\nompageref{X}
  \item [{$D_{ij}$}]\begingroup Dispersive stress tensor\nomeqref {0.0}\nompageref{X}
  \item [{$k_s^+$}]\begingroup Equivalent sand-grain roughness, in wall units\nomeqref {0.0}\nompageref{X}
  \item [{$p$}]\begingroup Pressure\nomeqref {0.0}\nompageref{X}
  \item [{$R_{ij}$}]\begingroup Reynolds stress tensor\nomeqref {0.0}\nompageref{X}
  \item [{$Re$}]\begingroup Reynolds number\nomeqref {0.0}\nompageref{X}
  \item [{$Re_b$}]\begingroup Bulk Reynolds number\nomeqref {0.0}\nompageref{X}
  \item [{$Re_\tau$}]\begingroup Friction Reynolds number\nomeqref {0.0}\nompageref{X}
  \item [{$U$}]\begingroup Mean (double-averaged) velocity\nomeqref {0.0}\nompageref{X}
  \item [{$U_b$}]\begingroup Bulk velocity\nomeqref {0.0}\nompageref{X}
  \item [{$U^+$}]\begingroup Mean velocity in viscous units\nomeqref {0.0}\nompageref{X}
  \item [{$u_i$}]\begingroup Instantaneous velocity component\nomeqref {0.0}\nompageref{X}
  \item [{$u_i'$}]\begingroup Temporal velocity fluctuation\nomeqref {0.0}\nompageref{X}
  \item [{$\tilde{u}_i$}]\begingroup Spatial velocity fluctuation\nomeqref {0.0}\nompageref{X}
  \item [{$u_i^*$}]\begingroup Total fluctuation\nomeqref {0.0}\nompageref{X}
  \item [{$u_\tau$}]\begingroup Friction velocity\nomeqref {0.0}\nompageref{X}
  \item [{$y^+$}]\begingroup Wall-normal distance in viscous units\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta U^+$}]\begingroup Roughness function\nomeqref {0.0}\nompageref{X}
  \item [{$\delta$}]\begingroup Characteristic length scale\nomeqref {0.0}\nompageref{X}
  \item [{$\delta_\nu$}]\begingroup Viscous length scale\nomeqref {0.0}\nompageref{X}
  \item [{$\eta$}]\begingroup Kolmogorov length scale\nomeqref {0.0}\nompageref{X}
  \item [{$\kappa$}]\begingroup von K\'arm\'an constant\nomeqref {0.0}\nompageref{X}
  \item [{$\Pi$}]\begingroup Driving pressure gradient\nomeqref {0.0}\nompageref{X}
  \item [{$\tau_p$}]\begingroup Pressure drag\nomeqref {0.0}\nompageref{X}
  \item [{$\tau_v$}]\begingroup Viscous drag\nomeqref {0.0}\nompageref{X}
  \item [{$\tau_w$}]\begingroup Wall shear stress\nomeqref {0.0}\nompageref{X}
\nomgroup{R}
  \item [{$ES$}]\begingroup Effective slope\nomeqref {0.0}\nompageref{X}
  \item [{$h$}]\begingroup Local surface height, relative to the virtual origin\nomeqref {0.0}\nompageref{X}
  \item [{$k$}]\begingroup Mean roughness height\nomeqref {0.0}\nompageref{X}
  \item [{$k^+$}]\begingroup Roughness height in viscous units\nomeqref {0.0}\nompageref{X}
  \item [{$S_a$}]\begingroup Average roughness height\nomeqref {0.0}\nompageref{X}
  \item [{$Sk$}]\begingroup Skewness of the surface height distribution\nomeqref {0.0}\nompageref{X}
  \item [{$S_q$}]\begingroup Root-mean-square roughness height\nomeqref {0.0}\nompageref{X}
  \item [{$S_{z_{max}}$}]\begingroup Maximum peak-to-valley height\nomeqref {0.0}\nompageref{X}
  \item [{$S_{z_{5\times5}}$}]\begingroup Mean peak-to-valley height\nomeqref {0.0}\nompageref{X}
\nomgroup{S}
  \item [{$C$}]\begingroup Mass flux\nomeqref {0.0}\nompageref{X}
  \item [{$c$}]\begingroup Courant-Friedrichs-Lewy (CFL) number\nomeqref {0.0}\nompageref{X}
  \item [{$N_\theta$}]\begingroup Number of grid points in azimuthal direction\nomeqref {0.0}\nompageref{X}
  \item [{$N_z$}]\begingroup Number of grid points streamwise direction\nomeqref {0.0}\nompageref{X}
  \item [{$p$}]\begingroup Polynomial order of the spectral element method\nomeqref {0.0}\nompageref{X}
  \item [{$T$}]\begingroup Averaging time\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta_{r_i}^+$}]\begingroup Wall-normal grid spacing at the $i$-th near-wall grid point, in wall units\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta t$}]\begingroup Simulation time step\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta_\theta$}]\begingroup Grid spacing in azimuthal direction\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta x$}]\begingroup Local spatial discretisation (used in the CFL number definition)\nomeqref {0.0}\nompageref{X}
  \item [{$\Delta_z$}]\begingroup Grid spacing in streamwise direction\nomeqref {0.0}\nompageref{X}

\end{thenomenclature}
